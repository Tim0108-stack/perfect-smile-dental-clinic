# ──────────────────────────────────────────────────────────────
# Perfect Smile Clinic Workspace — environment configuration
#
# Copy this file to `.env` in the project root and fill in the
# values for your local Supabase project. Both the client (Vite)
# and the server (Express) read from this single root .env file,
# so you only need to configure things in one place.
#
# Do NOT commit the real `.env` file to version control.
# ──────────────────────────────────────────────────────────────

# Supabase (used by the client — client-safe/public keys only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server authentication uses the same project URL and client-safe anon key.
# Never place a Supabase service-role key in the browser or this file.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Client
# Base URL the client uses to reach the API in dev. Leave as-is when
# using the built-in Vite dev proxy (see client/vite.config.ts).
VITE_API_BASE_URL=/api

# Server
PORT=3001
NODE_ENV=development
# Comma-separated list of origins allowed to call the API in dev.
CLIENT_ORIGIN=http://localhost:5173
